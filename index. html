<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Muhamad Gavin H.A – MY MEDSOS</title>
  <meta name="description" content="Temukan semua akun media sosial saya di satu halaman.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #E6EFEC;
      --ink: #12302F;
      --muted: #4A6664;
      --surface: #FFFFFF;
      --line: #C5D6D2;
      --accent: #F2B134;
      --on-accent: #12302F;
      --tile: #12302F;
      --on-tile: #E6EFEC;
      --focus: #1B6F6A;
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --bg: #0F1E1E;
        --ink: #E6F1EE;
        --muted: #9DB8B4;
        --surface: #172929;
        --line: #284240;
        --tile: #E6F1EE;
        --on-tile: #0F1E1E;
        --focus: #F2B134;
      }
    }
    :root[data-theme="dark"] {
      --bg: #0F1E1E;
      --ink: #E6F1EE;
      --muted: #9DB8B4;
      --surface: #172929;
      --line: #284240;
      --tile: #E6F1EE;
      --on-tile: #0F1E1E;
      --focus: #F2B134;
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { color-scheme: light dark; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: "Bricolage Grotesque", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }
    :focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }

    /* Tata letak: profil di kiri, daftar link di kanan (menumpuk di layar kecil) */
    .page {
      min-height: 100svh;
      max-width: 1040px;
      margin: 0 auto;
      padding: 48px 20px 40px;
      display: grid;
      gap: 40px;
      align-content: start;
    }
    @media (min-width: 860px) {
      .page {
        grid-template-columns: 340px 1fr;
        gap: 72px;
        padding: 96px 32px 56px;
        align-items: start;
      }
      .profile { position: sticky; top: 96px; }
    }

    /* Profil */
    .avatar {
      width: 88px; height: 88px;
      border-radius: 28px;
      background: var(--accent);
      color: var(--on-accent);
      display: grid; place-items: center;
      font-size: 2rem; font-weight: 800; letter-spacing: -0.02em;
      overflow: hidden;
    }
    .avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
    h1 {
      margin: 24px 0 8px;
      font-size: clamp(2.5rem, 7vw, 3.75rem);
      font-weight: 800;
      line-height: 1;
      letter-spacing: -0.035em;
    }
    .role { margin: 0 0 12px; font-size: 1.1rem; font-weight: 600; }
    .bio { margin: 0 0 24px; max-width: 34ch; color: var(--muted); }
    .actions { display: flex; flex-wrap: wrap; gap: 10px; }
    .btn {
      font: inherit; font-size: 0.95rem; font-weight: 600;
      padding: 10px 16px;
      border-radius: 999px;
      border: 1.5px solid var(--ink);
      background: transparent;
      color: var(--ink);
      cursor: pointer;
    }
    .btn:hover { background: var(--ink); color: var(--bg); }

    /* Daftar link */
    .links { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
    .link {
      display: flex; align-items: center; gap: 16px;
      padding: 14px 18px 14px 14px;
      background: var(--surface);
      border: 1.5px solid var(--line);
      border-radius: 18px;
      color: inherit;
      text-decoration: none;
      transition: background-color .18s ease, border-color .18s ease, transform .18s ease;
    }
    .link:hover { background: var(--accent); border-color: var(--ink); color: var(--on-accent); transform: translateX(4px); }
    .link:hover .handle { color: var(--on-accent); }
    .tile {
      flex: none;
      width: 46px; height: 46px;
      border-radius: 14px;
      background: var(--tile);
      color: var(--on-tile);
      display: grid; place-items: center;
    }
    .link:hover .tile { background: var(--on-accent); color: var(--accent); }
    .tile svg, .chevron { width: 22px; height: 22px; }
    svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .text { flex: 1; min-width: 0; display: flex; flex-direction: column; }
    .name { font-size: 1.1rem; font-weight: 600; line-height: 1.25; }
    .handle { font-size: 0.92rem; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .chevron { flex: none; opacity: .6; }

    footer { grid-column: 1 / -1; color: var(--muted); font-size: 0.9rem; }

    /* Satu animasi saat halaman dibuka */
    @media (prefers-reduced-motion: no-preference) {
      .links li { animation: rise .5s ease both; animation-delay: calc(var(--i) * 60ms); }
      @keyframes rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
    }
  </style>
</head>
<body>
  <main class="page">
    <header class="profile">
      <!-- Ganti isi div ini dengan <img src="fotomu.jpg" alt="Foto Nama Kamu"> jika ingin pakai foto -->
      <div class="avatar" aria-hidden="true">BIG G</div>
      <h1>M.Gavin Hipzdal A.P</h1>
      <p class="role">Gamer</p>
      <p class="bio">Someone you would find. All my medsoc in 1 page.</p>
      <div class="actions">
        <button class="btn" id="copy-btn" type="button">Salin link halaman</button>
        <button class="btn" id="theme-btn" type="button">Mode gelap</button>
      </div>
    </header>

    <nav aria-label="Media sosial">
      <ul class="links" id="link-list"></ul>
    </nav>

    <footer>© <span id="year"></span> Gavin </footer>
  </main>

  <script>
    // ====== EDIT DI SINI: daftar link medsosmu ======
    // icon: instagram | tiktok | youtube |  whatsapp | email
    const LINKS = [
      { name: "Instagram", handle: "@byzend",        url: "https://www.instagram.com/byze.nd?evlk=MXVxZjZreG8wZXYxYg==",      icon: "instagram" },
        { name: "Instagram", handle: "@byzend <br> sec acc",        url: "https://www.instagram.com/not_urfinn?bqrl=cjFyZjY5amNkNWc=",      icon: "instagram" },
      { name: "TikTok",    handle: "@Byzend",        url: "https://www.tiktok.com/@vinland_pubeg?_r=1&_t=ZS-9BZGA4yrgtY",        icon: "tiktok" },
      { name: "YouTube",   handle: "Byzen Gemenk",         url: "https://youtube.com/@byzengemenk6211?si=c1usvjQB_1aXuqDZ",       icon: "youtube" },
      { name: "WhatsApp",  handle: "G@F3!n",          url: "https://wa.me/6285156563665",             icon: "whatsapp" },
      
    ];

    const ICONS = {
      instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".6"/>',
      tiktok:    '<path d="M14 4v10.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 4c0 2.5 2 4.5 5 4.5"/>',
      youtube:   '<rect x="2" y="5" width="20" height="14" rx="4"/><path d="M10 9l5 3-5 3z"/>',
      whatsapp:  '<path d="M3 21l1.6-4.6A9 9 0 1 1 8 19.6L3 21z"/><path d="M9 9.5c.5 2.5 2.5 4.5 5 5l1.2-1.2-2-1-.8.8c-1-.4-1.8-1.2-2.2-2.2l.8-.8-1-2L9 9.5z"/>',
      email:     '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3.5 7.5l8.5 6 8.5-6"/>'
    };

    // Tampilkan daftar link
    const list = document.getElementById("link-list");
    LINKS.forEach((item, i) => {
      const external = item.url.startsWith("http");
      const li = document.createElement("li");
      li.style.setProperty("--i", i);
      li.innerHTML =
        '<a class="link" href="' + item.url + '"' + (external ? ' target="_blank" rel="noopener noreferrer"' : '') + '>' +
          '<span class="tile"><svg viewBox="0 0 24 24" aria-hidden="true">' + (ICONS[item.icon] || ICONS.email) + '</svg></span>' +
          '<span class="text"><span class="name">' + item.name + '</span><span class="handle">' + item.handle + '</span></span>' +
          '<svg class="chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>' +
        '</a>';
      list.appendChild(li);
    });

    // Tahun di footer
    document.getElementById("year").textContent = new Date().getFullYear();

    // Tombol salin link halaman
    const copyBtn = document.getElementById("copy-btn");
    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        copyBtn.textContent = "Link tersalin";
      } catch (err) {
        copyBtn.textContent = "Gagal menyalin";
      }
      setTimeout(() => { copyBtn.textContent = "Salin link halaman"; }, 1800);
    });

    // Tombol mode gelap / terang
    const root = document.documentElement;
    const themeBtn = document.getElementById("theme-btn");
    const prefersDark = window.matchMedia("(prefers-color-scheme: dark)");

    function currentTheme() {
      return root.dataset.theme || (prefersDark.matches ? "dark" : "light");
    }
    function updateThemeLabel() {
      themeBtn.textContent = currentTheme() === "dark" ? "Mode terang" : "Mode gelap";
    }
    try {
      const saved = localStorage.getItem("theme");
      if (saved === "dark" || saved === "light") root.dataset.theme = saved;
    } catch (err) { /* penyimpanan tidak tersedia, abaikan */ }
    updateThemeLabel();

    themeBtn.addEventListener("click", () => {
      const next = currentTheme() === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try { localStorage.setItem("theme", next); } catch (err) { /* abaikan */ }
      updateThemeLabel();
    });
  </script>
</body>
</html>